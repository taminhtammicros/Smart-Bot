# ============================================================================
#  2Anh Zalo Bot — .env cho phát triển (TUỲ CHỌN)
# ============================================================================
#  Không bắt buộc: `./scripts/setup.sh` đã tạo .env từ .env.example.
#  Tệp này chỉ để tham chiếu nhanh những giá trị hay đổi khi phát triển.
#  Sao chép nội dung cần dùng vào .env — KHÔNG đặt tên tệp này là .env.dev
#  rồi trỏ nhầm, vì .gitignore đã loại .env.* (trừ .env.example).

# --- Bắt buộc khi chạy nhiều bản song song --------------------------------
# Mỗi bản cần cổng riêng, nếu không bản thứ hai thoát với EADDRINUSE.
# ZCA_PORT=3872
# ZALO_BRIDGE_PORT=3873

# --- Giảm nhiễu khi phát triển -------------------------------------------
# Không gọi Zalo thật: plugin Hermes bỏ qua khi bridge chưa sẵn sàng.
# ZALO_GROUP_REPLY_ONLY_TAGGED=true

# --- Chạy thử nhanh, không chạm Zalo thật --------------------------------
# 1. Chỉ chạy dashboard (không cần đăng nhập Zalo):
#      ./scripts/run.sh --dashboard
# 2. Kiểm tra sidecar sống:
#      curl http://127.0.0.1:3872/api/health
# 3. Chạy test:
#      npm run test:js
#      ./scripts/setup.sh --venv && npm run test:py
